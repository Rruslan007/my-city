<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no">
    <title>Novara City</title>
    <link href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #0a0e1a;
            --bg-secondary: #1a1f2f;
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.08);
            --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
            --gold: #ffd700;
            --gold-gradient: linear-gradient(135deg, #f7971e, #ffd200);
            --green: #00c853;
            --red: #d50000;
            --blue: #1a3a6a;
            --text-primary: #ffffff;
            --text-secondary: #b0b0b0;
            --radius: 20px;
            --transition: 0.3s ease;
            --menu-bg-width: 1080;
            --menu-bg-height: 1920;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            min-height: 100dvh;
            overflow: hidden;
            position: relative;
            padding-bottom: 70px;
            touch-action: manipulation;
        }

        .glass {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius);
            box-shadow: var(--glass-shadow);
        }

        .btn-gold {
            background: var(--gold-gradient);
            border: none;
            color: #1a1a2e;
            font-weight: 700;
            padding: 10px 20px;
            border-radius: 12px;
            cursor: pointer;
            transition: var(--transition);
            font-size: 14px;
            width: 100%;
            text-align: center;
        }

        .btn-gold:hover {
            transform: scale(1.02);
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.3);
        }

        .btn-gold:disabled {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
        }

        .btn-green {
            background: var(--green);
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 10px;
            cursor: pointer;
            transition: var(--transition);
            font-size: 13px;
        }

        .btn-red {
            background: var(--red);
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 10px;
            cursor: pointer;
            transition: var(--transition);
            font-size: 13px;
        }

        .footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(10, 14, 26, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 1px solid var(--glass-border);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 6px 0 env(safe-area-inset-bottom, 6px) 0;
            height: 64px;
        }

        .footer button {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 9px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            padding: 2px 0;
            flex: 1 1 0;
            max-width: 90px;
        }

        .footer button img {
            width: 28px;
            height: 28px;
            object-fit: contain;
            filter: grayscale(0.6) brightness(0.7);
            transition: var(--transition);
        }

        .footer button.active img {
            filter: drop-shadow(0 0 10px gold) brightness(1);
        }

        .footer button.active {
            color: var(--gold);
        }

        .footer button .label {
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            opacity: 0.7;
        }

        .footer button.active .label {
            opacity: 1;
        }

        .screen {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 64px;
            overflow-y: auto;
            padding: 16px;
            padding-bottom: 20px;
        }

        .screen.active {
            display: block;
        }

        .screen::-webkit-scrollbar {
            width: 4px;
        }

        .screen::-webkit-scrollbar-track {
            background: transparent;
        }

        .screen::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 4px;
        }

        .lang-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .lang-modal.active {
            display: flex;
        }

        .lang-modal .box {
            background: linear-gradient(135deg, #00c853, #ffeb3b);
            padding: 30px 24px;
            border-radius: 24px;
            max-width: 340px;
            width: 100%;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
        }

        .lang-modal .box h2 {
            color: #1a1a2e;
            font-size: 20px;
            margin-bottom: 20px;
        }

        .lang-modal .box .btn-lang {
            display: block;
            width: 100%;
            padding: 14px;
            margin: 8px 0;
            border: none;
            border-radius: 14px;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            background: #fff;
            color: #1a1a2e;
        }

        /* === МЕНЮ === */
        #menu-screen {
            background: url('https://rruslan007.github.io/novara-city-images/effects/menu.png') center/cover no-repeat;
            background-size: cover;
            background-position: center;
            padding: 0;
            top: 0;
            left: 0;
            right: 0;
            bottom: 64px;
            overflow: hidden !important;
            position: fixed;
        }

        #menu-screen .overlay {
            position: relative;
            width: 100%;
            height: 100%;
            max-width: 100%;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            gap: 20px;
            padding: 20px;
            padding-bottom: 38px;
        }

        /* Новые кнопки меню */
        .menu-btn-wide {
            width: 100%;
            max-width: 400px;
            padding: 18px 24px;
            border: 3px solid #ff9800;
            border-radius: 18px !important;
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            transition: var(--transition);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .menu-btn-wide img {
            width: 36px;
            height: 36px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }
        .menu-btn-wide.btn-city {
            background: #00c853;
        }
        .menu-btn-wide.btn-store {
            background: #fbc02d;
            color: #1a1a2e;
        }
        .menu-btn-wide.btn-store img {
            filter: none;
        }
        .menu-btn-wide.btn-settings {
            background: #78909c;
        }
        .menu-btn-wide:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
        }

        .menu-btn-half-row {
            display: flex;
            gap: 12px;
            width: 100%;
            max-width: 400px;
        }
        .menu-btn-half {
            flex: 1;
            padding: 14px 8px;
            border: 3px solid #ff9800;
            border-radius: 14px !important;
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            transition: var(--transition);
        }
        .menu-btn-half img {
            width: 32px;
            height: 32px;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }
        .menu-btn-half.btn-complaints {
            background: #d50000;
        }
        .menu-btn-half.btn-settings {
            background: #78909c;
        }
        .menu-btn-half:hover {
            transform: scale(1.02);
        }

        /* Город (пункт) */
        #city-screen {
            background: #b2d8a8;
            background: linear-gradient(145deg, #b2d8a8, #8fc77d, #a8d08d);
            background-size: 200% 200%;
            animation: chameleon 8s ease-in-out infinite alternate;
            padding: 16px;
            top: 0;
            bottom: 64px;
            overflow-x: hidden;
            touch-action: pan-y;
        }
        @keyframes chameleon {
            0% { background: #b2d8a8; }
            50% { background: #9bc78a; }
            100% { background: #c5e0b5; }
        }

        #city-screen .city-title {
            text-align: center;
            font-size: clamp(17px, 5vw, 22px);
            font-weight: 700;
            color: #1a2e1a;
            margin-bottom: 16px;
            text-shadow: 0 2px 4px rgba(255,255,255,0.3);
        }

        .city-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            max-width: 600px;
            margin: 0 auto;
        }
        .city-item {
            aspect-ratio: 1 / 1.2;
            background: rgba(0,0,0,0.5);
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 8px;
            border: 2px solid rgba(255,255,255,0.1);
            transition: var(--transition);
            position: relative;
            gap: 4px;
        }
        .city-item.locked {
            background: rgba(0,0,0,0.6);
            color: #888;
        }
        .city-item.locked .lock-icon {
            font-size: 28px;
        }
        .city-item.locked .level-req {
            font-size: clamp(10px, 3vw, 12px);
            font-weight: 700;
            color: #aaa;
        }
        .city-item.unlocked {
            background: #111;
            border-color: var(--gold);
            cursor: pointer;
        }
        .city-item.unlocked .open-btn {
            background: var(--gold-gradient);
            border: none;
            color: #1a1a2e;
            font-weight: 700;
            padding: 6px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            margin-top: 4px;
        }
        .city-item.unlocked .open-btn:hover {
            transform: scale(1.05);
        }
        .city-item .district-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--gold);
            animation: pulse 2s ease-in-out infinite;
            background: #1a1f2f;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
        .city-item .district-name {
            font-size: clamp(10px, 3vw, 13px);
            font-weight: 600;
            color: #fff;
            margin-top: 4px;
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
            line-height: 1.2;
            word-break: break-word;
        }
        .city-item.coming-soon {
            background: #000;
            border-color: #555;
        }
        .city-item.coming-soon .soon-icon {
            font-size: 32px;
            color: #ffeb3b;
        }
        .city-item.coming-soon .soon-label {
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            margin-top: 4px;
        }

        /* Окно выбора района */
        .district-select-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(4px);
            z-index: 800;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .district-select-modal.active {
            display: flex;
        }
        .district-select-box {
            background: #1a1f2f;
            border-radius: 16px;
            max-width: 420px;
            width: 100%;
            padding: 20px 16px;
            border: 1px solid var(--glass-border);
            position: relative;
            max-height: 80vh;
            overflow-y: auto;
        }
        .district-select-box .close-btn {
            position: absolute;
            top: 8px;
            right: 12px;
            background: none;
            border: none;
            color: var(--red);
            font-size: 24px;
            cursor: pointer;
        }
        .district-select-box .select-title {
            text-align: center;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 16px;
            color: #fff;
        }
        .district-select-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .district-select-item {
            background: rgba(255,255,255,0.05);
            border-radius: 8px;
            padding: 10px 4px;
            text-align: center;
            border: 1px solid var(--glass-border);
            cursor: pointer;
            transition: var(--transition);
            font-weight: 600;
            font-size: 12px;
            color: #fff;
        }
        .district-select-item:hover {
            background: rgba(255,215,0,0.15);
            border-color: var(--gold);
        }
        .district-select-item img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            display: block;
            margin: 0 auto 4px;
        }

        /* Магазин */
        #shop-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(4px);
            z-index: 800;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        #shop-modal.active {
            display: flex;
        }
        .shop-box {
            background: #6a1b9a;
            border: 4px solid #fbc02d;
            border-radius: 16px;
            max-width: 480px;
            width: 100%;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            position: relative;
            padding: 0 0 16px;
            overflow: hidden;
        }
        .shop-box .close-btn {
            position: absolute;
            top: 50%;
            right: 14px;
            transform: translateY(-50%);
            background: rgba(0,0,0,0.35);
            border: none;
            color: #ff1744;
            font-size: 26px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 5;
            line-height: 1;
        }
        .shop-header {
            display: flex;
            flex-direction: column;
            padding: 12px 12px 8px;
            flex-shrink: 0;
            gap: 6px;
        }
        .shop-header-bg {
            background: rgba(0,0,0,0.45);
            width: 100%;
            padding: 14px 50px;
            text-align: center;
            position: relative;
            flex-shrink: 0;
        }
        .shop-header-bg h2 {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            margin: 0;
            text-align: center;
        }
        .shop-balances {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
            flex-shrink: 0;
        }
        .shop-balances .bal-item {
            background: rgba(0,0,0,0.4);
            border-radius: 20px;
            padding: 2px 12px;
            font-size: 12px;
            font-weight: 600;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }
        .shop-balances .bal-item.crystals-item { padding: 2px 10px; }
        .shop-balances .bal-item img {
            width: 16px;
            height: 16px;
        }
        .shop-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 0 12px 0 12px;
            margin-top: 8px;
        }
        .shop-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .shop-scroll::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.3);
            border-radius: 4px;
        }
        .shop-section {
            background: rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 12px;
        }
        .shop-section .section-title {
            font-weight: 700;
            font-size: 16px;
            color: #fff;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .shop-section .section-title img {
            width: 24px;
            height: 24px;
        }
        .shop-items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
            gap: 6px;
        }
        .shop-item {
            background: rgba(0,0,0,0.3);
            border-radius: 8px;
            padding: 6px 4px;
            text-align: center;
            border: 2px solid rgba(255,255,255,0.1);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            min-width: 0;
        }
        .shop-item .item-badge {
            font-size: 8px;
            font-weight: 700;
            color: #fff;
            background: var(--red);
            padding: 0 6px;
            border-radius: 4px;
            text-transform: uppercase;
        }
        .shop-item .item-amount {
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            word-break: break-word;
        }
        .shop-item .item-amount img {
            width: 14px;
            height: 14px;
            vertical-align: middle;
        }
        .shop-item .item-price {
            font-size: 10px;
            color: #ffeb3b;
            font-weight: 600;
            word-break: break-word;
        }
        .shop-item .item-btn {
            background: var(--gold-gradient);
            border: none;
            color: #1a1a2e;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 12px;
            font-size: 11px;
            cursor: pointer;
            width: 100%;
            margin-top: 2px;
            white-space: normal;
            word-break: break-word;
            line-height: 1.2;
        }
        .shop-item .item-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .shop-item .item-btn.timer {
            background: #555;
            color: #fff;
        }
        .shop-item.green-item {
            border-color: #00c853;
        }
        .shop-item.green-item .item-badge {
            background: #00c853;
        }
        .shop-item.blue-item {
            border-color: #2196f3;
        }
        .shop-item.discount {
            border-color: #ff1744;
            position: relative;
        }
        .shop-item.discount .discount-tag {
            position: absolute;
            top: -6px;
            right: -6px;
            background: #ff1744;
            color: #fff;
            font-size: 8px;
            font-weight: 700;
            padding: 0 6px;
            border-radius: 4px;
        }

        /* ===== РЫНОК ===== */
        #marketModal {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.75);
            backdrop-filter: blur(4px);
            z-index: 810;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        #marketModal.active { display: flex; }
        .market-box {
            background: #1a3a6a;
            border: 4px solid var(--gold);
            border-radius: 16px;
            max-width: 480px;
            width: 100%;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
            position: relative;
            padding: 0 0 16px;
            overflow: hidden;
        }
        .market-header-bg {
            background: rgba(0,0,0,0.45);
            width: 100%;
            padding: 14px 50px;
            text-align: center;
            position: relative;
            flex-shrink: 0;
        }
        .market-header-bg h2 {
            font-size: 20px;
            font-weight: 700;
            color: #fff;
            margin: 0;
        }
        .market-header-bg .close-btn {
            position: absolute;
            top: 50%;
            right: 14px;
            transform: translateY(-50%);
            background: rgba(0,0,0,0.35);
            border: none;
            color: #ff1744;
            font-size: 26px;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            line-height: 1;
        }
        .market-timer {
            text-align: center;
            font-size: 13px;
            font-weight: 700;
            color: var(--gold);
            padding: 10px 12px 0;
            flex-shrink: 0;
        }
        .market-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 10px 12px 0;
        }
        .market-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .market-item {
            border: 2px solid var(--gold);
            border-radius: 14px;
            background: rgba(0,0,0,0.35);
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            position: relative;
            min-height: 130px;
        }
        .market-item.sold {
            border-color: var(--red);
        }
        .market-item .market-icon {
            width: 34px;
            height: 34px;
            object-fit: contain;
        }
        .market-item .market-amount {
            font-size: 13px;
            font-weight: 700;
            color: #fff;
        }
        .market-item .market-price {
            font-size: 11px;
            color: var(--gold);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 3px;
        }
        .market-item .market-buy-btn {
            margin-top: auto;
            width: 100%;
            background: var(--gold-gradient);
            border: none;
            color: #1a1a2e;
            font-weight: 700;
            padding: 4px 6px;
            border-radius: 10px;
            font-size: 12px;
            cursor: pointer;
        }
        .market-sold-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.75);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 8px;
        }
        .market-sold-overlay .sold-text {
            color: var(--red);
            font-weight: 800;
            font-size: 14px;
            letter-spacing: 0.5px;
        }
        .market-sold-overlay .market-refresh-btn {
            background: #1976d2;
            border: none;
            color: #fff;
            font-weight: 700;
            padding: 5px 10px;
            border-radius: 10px;
            font-size: 11px;
            cursor: pointer;
            text-align: center;
        }

        .shop-exchanger {
            margin-top: 4px;
            text-align: center;
        }
        .shop-exchanger .exchanger-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin: 6px 0;
        }
        .shop-exchanger .exchanger-row input[type="range"] {
            flex: 1;
            accent-color: var(--gold);
        }
        .shop-exchanger .exchanger-row .num-display {
            background: rgba(255,255,255,0.1);
            border-radius: 8px;
            padding: 4px 12px;
            font-weight: 700;
            font-size: 18px;
            min-width: 60px;
            text-align: center;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
        }
        .shop-exchanger .exchanger-row .num-display.active {
            border-color: var(--gold);
            background: rgba(255,215,0,0.2);
        }
        .shop-exchanger .exchanger-result {
            text-align: center;
            font-size: 16px;
            font-weight: 600;
            margin: 4px 0;
        }

        /* Промокод */
        .promo-section {
            background: rgba(255,255,255,0.08);
            border-radius: 12px;
            padding: 12px;
            margin-top: 4px;
            text-align: center;
        }
        .promo-section .promo-title {
            font-weight: 700;
            font-size: 14px;
            color: #fff;
            margin-bottom: 4px;
            text-align: center;
        }
        .promo-section .promo-row {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }
        .promo-section .promo-row input {
            width: 100%;
            max-width: 260px;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid var(--glass-border);
            background: rgba(255,255,255,0.1);
            color: #fff;
            font-size: 14px;
            text-align: center;
        }
        .promo-section .promo-row button {
            background: var(--gold-gradient);
            border: none;
            color: #1a1a2e;
            font-weight: 700;
            padding: 6px 24px;
            border-radius: 8px;
            cursor: pointer;
        }
        .promo-error {
            font-size: 12px;
            color: #ff1744;
            margin-top: 4px;
            display: none;
            text-align: center;
        }

        /* Настройки, Жалобы */
        .modal-settings, .modal-complaints {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
            z-index: 800;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .modal-settings.active, .modal-complaints.active {
            display: flex;
        }
        .settings-box, .complaints-box {
            background: #f5f0e8;
            border-radius: 16px;
            max-width: 420px;
            width: 100%;
            max-height: 80vh;
            overflow-y: auto;
            border: 3px solid #1a3a6a;
            position: relative;
        }
        .settings-box .modal-header, .complaints-box .modal-header {
            background: #1a3a6a;
            padding: 12px 16px;
            border-radius: 12px 12px 0 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 3px solid #1a3a6a;
        }
        .settings-box .modal-header h2, .complaints-box .modal-header h2 {
            color: #fff;
            font-size: 20px;
            margin: 0;
        }
        .settings-box .modal-header .close-btn, .complaints-box .modal-header .close-btn {
            background: none;
            border: none;
            color: #ff1744;
            font-size: 26px;
            cursor: pointer;
        }
        .settings-box .modal-body, .complaints-box .modal-body {
            padding: 16px;
            color: #1a1a2e;
        }
        .settings-box .modal-body .subtitle {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 8px;
            text-align: center;
        }
        .settings-box .modal-body .center-text {
            text-align: center;
            margin: 8px 0;
        }
        .settings-box .modal-body .btn-change-lang {
            background: var(--gold-gradient);
            border: none;
            color: #1a1a2e;
            font-weight: 700;
            padding: 8px 20px;
            border-radius: 8px;
            cursor: pointer;
            display: block;
            margin: 0 auto;
        }
        .complaints-box .modal-body textarea {
            width: 100%;
            padding: 8px;
            border-radius: 8px;
            border: 1px solid #ccc;
            min-height: 100px;
            font-family: inherit;
        }

        /* Футер для города */
        .footer-city {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 100;
            background: rgba(10, 14, 26, 0.85);
            backdrop-filter: blur(16px);
            border-top: 1px solid var(--glass-border);
            justify-content: center;
            align-items: center;
            padding: 6px 0 env(safe-area-inset-bottom, 6px) 0;
            height: 64px;
        }
        .footer-city.active {
            display: flex;
        }
        .footer-city button {
            background: none;
            border: none;
            color: var(--text-secondary);
            font-size: 9px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
            padding: 2px 0;
            flex: 1 1 0;
            max-width: 90px;
        }
        .footer-city button img {
            width: 28px;
            height: 28px;
            object-fit: contain;
            filter: grayscale(0.6) brightness(0.7);
            transition: var(--transition);
        }
        .footer-city button.active img {
            filter: drop-shadow(0 0 10px gold) brightness(1);
        }
        .footer-city button.active {
            color: var(--gold);
        }

        /* Затемнение */
        .fade-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: #000;
            opacity: 0;
            pointer-events: none;
            z-index: 999;
            transition: opacity 1s ease;
        }
        .fade-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        /* Убрал круги районов и круг опыта в меню */
        .district-btn-circle, .level-circle-wrapper {
            display: none !important;
        }

        /* Затемнение для ресурсов, квестов, профиля */
        .glass-dark {
            background: rgba(0,0,0,0.4) !important;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        /* Объединенный блок опыта и репутации */
        .xp-rep-bar {
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(8px);
            border-radius: 12px;
            padding: 4px 12px 8px 12px;
            border: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            gap: 2px;
            margin: 0 auto 8px auto;
            max-width: 300px;
        }
        .xp-rep-bar .top-row {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            font-weight: 600;
            color: #fff;
        }
        .xp-rep-bar .top-row .rep {
            color: var(--gold);
        }
        .xp-rep-bar .xp-track {
            width: 100%;
            height: 6px;
            background: rgba(255,255,255,0.15);
            border-radius: 4px;
            overflow: hidden;
        }
        .xp-rep-bar .xp-track .fill {
            height: 100%;
            background: var(--gold-gradient);
            border-radius: 4px;
            transition: width 0.5s ease;
        }

        /* Единый заголовок района: звезда с уровнем слева, название и XP справа */
        .district-header {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            background: rgba(10,14,26,0.9);
            backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--glass-border);
            height: 64px;
            box-sizing: border-box;
        }
        .district-star {
            position: relative;
            width: 46px;
            height: 46px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .district-star .star-icon {
            position: absolute;
            inset: 0;
            font-size: 46px;
            line-height: 46px;
            color: gold;
            text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        }
        .district-star .star-level {
            position: relative;
            color: #fff;
            font-weight: 800;
            font-size: 15px;
            text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        }
        .district-info {
            flex: 1;
            min-width: 0;
        }
        .district-name-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
        }
        .district-name {
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .district-rep {
            font-size: 12px;
            font-weight: 600;
            color: var(--gold);
            white-space: nowrap;
            flex-shrink: 0;
        }
        .district-xp-bar {
            position: relative;
            width: 100%;
            height: 12px;
            background: rgba(255,255,255,0.15);
            border-radius: 6px;
            overflow: hidden;
            margin-top: 4px;
        }
        .district-xp-bar .fill {
            height: 100%;
            background: var(--gold-gradient);
            border-radius: 6px;
            transition: width 0.5s ease;
        }
        .district-xp-bar .xp-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 9px;
            font-weight: 700;
            color: #fff;
            text-shadow: 0 1px 3px rgba(0,0,0,0.9);
            white-space: nowrap;
        }

        /* Карта: исправление сдвига — размер задаётся из JS под фактическую сетку,
           чтобы не оставалось "лишней" зелёной травы и участков за пределами видимой области */
        .map-world {
            position: relative;
            overflow: visible;
            background: #4a7c3f;
        }
        .map-scroll-container {
            width: 100%;
            height: 100%;
            overflow: auto;
        }
        .map-world .map-road-h, .map-world .map-road-v {
            background: #3a3a3a;
            position: absolute;
        }
        .map-world .map-road-h {
            height: 60px;
            left: 0;
        }
        .map-world .map-road-h::after {
            content: '';
            position: absolute;
            top: 28px;
            left: 0;
            width: 100%;
            height: 4px;
            background: repeating-linear-gradient(90deg, #fff 0px, #fff 20px, transparent 20px, transparent 30px);
        }
        .map-world .map-road-v {
            width: 60px;
            top: 0;
        }
        .map-world .map-road-v::after {
            content: '';
            position: absolute;
            left: 28px;
            top: 0;
            width: 4px;
            height: 100%;
            background: repeating-linear-gradient(180deg, #fff 0px, #fff 20px, transparent 20px, transparent 30px);
        }
        /* Перекрёстки — отдельные плитки поверх дорог, без полос */
        .map-world .map-intersection {
            position: absolute;
            width: 60px;
            height: 60px;
            background: #3a3a3a;
            z-index: 1;
        }

        /* Аккордеон банка: раскрытие тела и поворот стрелки по классу .open */
        .accordion .header .arrow {
            display: inline-block;
            transition: transform 0.3s ease;
        }
        .accordion .header .arrow.open {
            transform: rotate(180deg);
        }
        .accordion .body {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease;
            padding: 0 16px;
        }
        .accordion .body.open {
            max-height: 600px;
            padding: 0 16px 16px;
            overflow-y: auto;
        }
        .page-title {
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            text-align: center;
            padding: 8px 0 12px 0;
            margin: 0;
        }
        #resourcesTitle { transform: translateY(2px); }
        #bankTitle { transform: translateY(5px); }
        #questsTitle { transform: translateY(1.5px); }
        #profileTitle { transform: translateY(2.5px); }
        #profile-screen .profile-shift-down {
            margin-top: 40px;
        }

        /* Ресурсы: верхний ряд (Рынок слева, балансы справа) */
        .res-top-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            max-width: 460px;
            margin: 38px auto 14px;
        }
        .res-balances {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 6px;
        }
        .res-bal-oval {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            background: rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-radius: 999px;
            padding: 5px 12px;
            cursor: pointer;
            white-space: nowrap;
        }
        .res-bal-oval.crystals-oval { padding: 5px 10px; }
        .res-bal-oval img { width: 16px; height: 16px; }
        .res-market-btn {
            flex: 0 0 auto;
            padding: 8px 20px;
            background: var(--gold-gradient);
            border: 1.5px solid #fff;
            border-radius: 18px;
            color: #fff;
            font-weight: 800;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            cursor: pointer;
            text-shadow: 0 1px 3px rgba(0,0,0,0.5);
        }
        .res-scroll-box {
            max-width: 460px;
            margin: 0 auto;
            background: rgba(0, 0, 0, 0.35);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1.5px solid #fff;
            border-radius: 18px;
            padding: 0 12px 12px;
            height: 420px;
            min-height: 160px;
            max-height: calc(100dvh - 220px);
            overflow-y: auto;
            overflow-x: hidden;
            touch-action: pan-y;
            overscroll-behavior: contain;
            position: relative;
        }
        .res-scroll-box::-webkit-scrollbar { width: 4px; }
        .res-scroll-box::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.3);
            border-radius: 4px;
        }

        /* Фоны разделов */
        #bank-screen {
            background: url('https://rruslan007.github.io/novara-city-images/effects/bank_fon.png') center/cover no-repeat fixed;
        }
        #resources-screen {
            background: url('https://rruslan007.github.io/novara-city-images/effects/res_fon.png') center/cover no-repeat fixed;
        }
        #quests-screen {
            background: url('https://rruslan007.github.io/novara-city-images/effects/quests.png') center/cover no-repeat fixed;
        }
        #profile-screen {
            background: url('https://rruslan007.github.io/novara-city-images/effects/profile_fon.png') center/cover no-repeat fixed;
        }

        /* Квесты */
        .quests-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            position: relative;
            z-index: 2;
        }
        .quest-category {
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(8px);
            border-radius: 12px;
            padding: 10px 12px;
            border: 1px solid var(--glass-border);
            position: relative;
            z-index: 2;
        }
        .quest-category .cat-title {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 6px;
            text-align: center;
            background: rgba(0,0,0,0.55);
            border-radius: 18px;
            padding: 10px 12px;
        }
        .quest-category .cat-sub {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
            text-align: center;
        }
        .quest-item {
            background: rgba(0,0,0,0.55);
            border-radius: 20px;
            padding: 12px 14px;
            margin-bottom: 10px;
            border: 1px solid var(--glass-border);
            transition: var(--transition);
            position: relative;
            z-index: 2;
        }
        .quest-item.completed {
            opacity: 0.5;
            background: rgba(0,0,0,0.3);
        }
        .quest-item .q-title {
            font-weight: 700;
            font-size: 14px;
            color: #fff;
            text-align: center;
        }
        .quest-item .q-desc {
            font-size: 12px;
            color: var(--text-secondary);
            text-align: center;
            margin: 4px 0;
        }
        .quest-item .q-progress {
            width: 100%;
            height: 16px;
            background: rgba(255,255,255,0.1);
            border-radius: 8px;
            overflow: hidden;
            margin: 6px 0;
            position: relative;
        }
        .quest-item .q-progress .fill {
            height: 100%;
            background: var(--gold-gradient);
            border-radius: 8px;
            transition: width 0.5s ease;
        }
        .quest-item .q-progress .p-text {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 10px;
            font-weight: 700;
            color: #fff;
            text-shadow: 0 1px 4px rgba(0,0,0,0.9);
            white-space: nowrap;
        }
        .quest-item .q-reward-title {
            text-align: center;
            font-size: 13px;
            color: #fff;
            font-weight: 700;
            margin-top: 4px;
        }
        .quest-item .q-reward-values {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            font-size: 12px;
            color: var(--gold);
            font-weight: 600;
            margin-top: 2px;
        }
        .quest-item .q-reward-values img {
            width: 14px;
            height: 14px;
            vertical-align: middle;
            margin-right: 2px;
        }
        .quest-item .q-btn {
            display: block;
            width: 100%;
            padding: 4px;
            border-radius: 8px;
            border: none;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            margin-top: 4px;
        }
        .quest-item .q-btn.gold {
            background: var(--gold-gradient);
            color: #1a1a2e;
        }
        .quest-item .q-btn.gray {
            background: #555;
            color: #aaa;
            cursor: not-allowed;
        }
        .quest-item .q-done {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 18px;
            font-weight: 700;
            color: #00c853;
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(0,0,0,0.7);
            padding: 4px 16px;
            border-radius: 20px;
            pointer-events: none;
        }
        .quest-item .q-done .check {
            display: inline-block;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #00c853;
            color: #fff;
            text-align: center;
            line-height: 20px;
            font-size: 14px;
        }

        /* Окно подтверждения */
        .confirm-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.7);
            z-index: 900;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        .confirm-overlay.active {
            display: flex;
        }
        .confirm-box {
            background: #1a1f2f;
            border-radius: 16px;
            max-width: 360px;
            width: 100%;
            border: 1px solid var(--glass-border);
            overflow: hidden;
        }
        .confirm-box .confirm-header {
            background: #1a3a6a;
            padding: 10px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 700;
            font-size: 16px;
            color: #fff;
        }
        .confirm-box .confirm-header .close-btn {
            background: none;
            border: none;
            color: #ff1744;
            font-size: 22px;
            cursor: pointer;
        }
        .confirm-box .confirm-body {
            padding: 16px;
            color: #fff;
            text-align: center;
        }
        .confirm-box .confirm-actions {
            display: flex;
            gap: 0;
            border-top: 1px solid var(--glass-border);
        }
        .confirm-box .confirm-actions button {
            flex: 1;
            padding: 10px;
            border: none;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
        }
        .confirm-box .confirm-actions .btn-cancel {
            background: #555;
            color: #fff;
        }
        .confirm-box .confirm-actions .btn-confirm {
            background: var(--gold-gradient);
            color: #1a1a2e;
        }

        /* Исправления */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            z-index: 500;
            justify-content: center;
            align-items: flex-end;
            padding: 20px;
        }
        .modal-overlay.active {
            display: flex;
        }
    </style>
</head>
<body>

    <!-- ===== ЯЗЫКОВАЯ МОДАЛКА ===== -->
    <div class="lang-modal" id="langModal">
        <div class="box">
            <h2 id="langTitle">Choose Language / Выберите язык</h2>
            <button class="btn-lang" onclick="setLang('en')">🇬🇧 English</button>
            <button class="btn-lang" onclick="setLang('ru')">🇷🇺 Русский</button>
        </div>
    </div>

    <!-- ===== МЕНЮ ===== -->
    <div class="screen active" id="menu-screen">
        <div class="overlay">
            <button class="menu-btn-wide btn-city" onclick="openCity()">
                <span>Город</span>
                <img src="https://rruslan007.github.io/novara-city-images/logo/city_icon.png" alt="city">
            </button>
            <button class="menu-btn-wide btn-store" onclick="openShop()">
                <span>Магазин</span>
                <img src="https://rruslan007.github.io/novara-city-images/logo/store.png" alt="store">
            </button>
            <button class="menu-btn-wide btn-settings" onclick="openSettings()">
                <span id="menuSettingsLabel">Настройки</span>
                <img src="https://rruslan007.github.io/novara-city-images/logo/settings.png" alt="settings">
            </button>
        </div>
    </div>

    <!-- ===== ГОРОД (ПУНКТ) ===== -->
    <div class="screen" id="city-screen">
        <div class="city-title">Выберите район:</div>
        <div class="city-grid" id="cityGrid"></div>
    </div>

    <!-- ===== КАРТА ===== -->
    <div class="screen" id="map-screen">
        <div class="district-header" id="districtHeader">
            <div class="district-star">
                <span class="star-icon">★</span>
                <span class="star-level" id="mapLvlTop">1</span>
            </div>
            <div class="district-info">
                <div class="district-name-row">
                    <span class="district-name" id="mapTitle">Район</span>
                    <span class="district-rep">🏅 <span id="mapReputationTop">0</span></span>
                </div>
                <div class="district-xp-bar">
                    <div class="fill" id="mapXpFillTop" style="width:0%"></div>
                    <span class="xp-text" id="mapXpLabelTop">0 / 100 XP</span>
                </div>
            </div>
        </div>
        <div class="map-scroll-container" id="mapScrollContainer" style="position:absolute;top:64px;left:0;right:0;bottom:0;overflow:auto;">
            <div class="map-world" id="mapWorld"></div>
        </div>
    </div>

    <!-- ===== БАНК ===== -->
    <div class="screen" id="bank-screen">
        <div class="page-title" id="bankTitle">Банк</div>
        <div class="bank-accordion-wrapper" style="display:flex;flex-direction:column;gap:12px;max-width:420px;margin:0 auto;">
            <div class="accordion" style="border:1px solid rgba(255,255,255,0.15);border-radius:12px;overflow:hidden;background:rgba(10,14,26,0.7);backdrop-filter:blur(8px);">
                <div class="header" onclick="toggleAccordion(this)" style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;cursor:pointer;transition:var(--transition);">
                    <div class="left" style="display:flex;align-items:center;gap:10px;font-weight:600;font-size:15px;"><img src="https://rruslan007.github.io/novara-city-images/logo/bank_icon.png" alt="bank" style="width:24px;height:24px;"> <span id="bankMyBank">Мой банк</span></div>
                    <span class="arrow open" style="font-size:18px;color:var(--text-secondary);">▼</span>
                </div>
                <div class="body open" style="overflow-y:auto;">
                    <div style="font-weight:600;font-size:14px;text-align:center;margin-bottom:6px;" id="bankMyBankTitle">Мой банк</div>
                    <div class="bank-row" style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:14px;">
                        <div class="label" style="display:flex;align-items:center;gap:6px;"><img src="https://rruslan007.github.io/novara-city-images/effects/moneta.PNG" style="width:20px;height:20px;"> Novara Coin</div>
                        <span id="bankBalanceDisplay">1000</span>
                    </div>
                    <div class="bank-row" style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:14px;">
                        <span>💎 Novara Crystals</span><span id="bankCrystalsDisplay">50</span>
                    </div>
                    <div style="margin-top:12px;text-align:center;">
                        <button class="btn-gold" id="bankReplenishBtn" onclick="showToast('💰 Пополнение в разработке')" style="width:auto;padding:6px 20px;">Пополнить</button>
                    </div>
                </div>
            </div>
            <div class="accordion" style="border:1px solid rgba(255,255,255,0.15);border-radius:12px;overflow:hidden;background:rgba(10,14,26,0.7);backdrop-filter:blur(8px);">
                <div class="header" onclick="toggleAccordion(this)" style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;cursor:pointer;transition:var(--transition);">
                    <div class="left" style="display:flex;align-items:center;gap:10px;font-weight:600;font-size:15px;"><img src="https://rruslan007.github.io/novara-city-images/logo/credit_icon.png" alt="credit" style="width:24px;height:24px;"> <span id="bankCredit">Кредит</span></div>
                    <span class="arrow" style="font-size:18px;color:var(--text-secondary);">▼</span>
                </div>
                <div class="body">
                    <div style="font-weight:600;font-size:14px;text-align:center;margin-bottom:6px;" id="bankCreditTitle">Кредит</div>
                    <div id="creditInfo"><span style="color:var(--text-secondary);">Нет активных кредитов</span></div>
                    <div style="text-align:center;margin-top:12px;" id="creditBtnWrapper">
                        <button class="btn-gold" id="bankTakeCredit" onclick="openCreditModal()" style="width:auto;padding:6px 20px;">Взять кредит</button>
                    </div>
                </div>
            </div>
            <div class="accordion" style="border:1px solid rgba(255,255,255,0.15);border-radius:12px;overflow:hidden;background:rgba(10,14,26,0.7);backdrop-filter:blur(8px);">
                <div class="header" onclick="toggleAccordion(this)" style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;cursor:pointer;transition:var(--transition);">
                    <div class="left" style="display:flex;align-items:center;gap:10px;font-weight:600;font-size:15px;"><img src="https://rruslan007.github.io/novara-city-images/logo/crypto_icon.png" alt="crypto" style="width:24px;height:24px;"> <span id="bankCrypto">Криптовалюта</span></div>
                    <span class="arrow" style="font-size:18px;color:var(--text-secondary);">▼</span>
                </div>
                <div class="body">
                    <div id="cryptoPortfolio"><span style="color:var(--text-secondary);">У вас нет криптовалют</span></div>
                    <div style="text-align:center;margin-top:12px;">
                        <button class="btn-gold" onclick="openCryptoExchange()" style="width:auto;padding:6px 20px;">🚀 Биржа</button>
                    </div>
                </div>
            </div>
            <div class="accordion" style="border:1px solid rgba(255,255,255,0.15);border-radius:12px;overflow:hidden;background:rgba(10,14,26,0.7);backdrop-filter:blur(8px);">
                <div class="header" onclick="toggleAccordion(this)" style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px;cursor:pointer;transition:var(--transition);">
                    <div class="left" style="display:flex;align-items:center;gap:10px;font-weight:600;font-size:15px;"><img src="https://rruslan007.github.io/novara-city-images/logo/income_and_expence_icon.png" alt="stats" style="width:24px;height:24px;"> <span id="bankStats">Доходы и расходы</span></div>
                    <span class="arrow" style="font-size:18px;color:var(--text-secondary);">▼</span>
                </div>
                <div class="body">
                    <div style="font-weight:600;font-size:14px;text-align:center;margin-bottom:6px;" id="bankStatsTitle">Доходы и расходы</div>
                    <div class="bank-row" style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:14px;"><span id="bankIncomeLabel">📈 Доходы:</span><span class="text-green" style="display:flex;align-items:center;gap:4px;"><span id="bankIncome">0</span><img src="https://rruslan007.github.io/novara-city-images/effects/moneta.PNG" style="width:16px;height:16px;"><span id="bankIncomeSuffix">/мин</span></span></div>
                    <div class="bank-row" style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:14px;"><span id="bankExpenseLabel">📉 Расходы:</span><span class="text-red" style="display:flex;align-items:center;gap:4px;"><span id="bankExpense">0</span><img src="https://rruslan007.github.io/novara-city-images/effects/moneta.PNG" style="width:16px;height:16px;"><span id="bankExpenseSuffix">/мин</span></span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== РЕСУРСЫ ===== -->
    <div class="screen" id="resources-screen">
        <div class="page-title" id="resourcesTitle">Ресурсы</div>
        <div class="res-top-row">
            <button class="res-market-btn" id="resMarketBtn" onclick="openMarket()">Рынок</button>
            <div class="res-balances">
                <div class="res-bal-oval" onclick="goToShopSection('coin')">
                    <img src="https://rruslan007.github.io/novara-city-images/effects/moneta.PNG" alt="coins">
                    <span id="resBankCoins">0</span>
                </div>
                <div class="res-bal-oval crystals-oval" onclick="goToShopSection('diamond')">
                    <span style="font-size:13px;">💎</span>
                    <span id="resBankCrystals">0</span>
                </div>
            </div>
        </div>
        <div class="res-scroll-box" id="resScrollBox">
            <div class="resource-grid" id="resourceGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;"></div>
        </div>
    </div>

    <!-- ===== КВЕСТЫ ===== -->
    <div class="screen" id="quests-screen">
        <div class="page-title" id="questsTitle">Квесты</div>
        <div class="quests-container" id="questsList"></div>
    </div>

    <!-- ===== ПРОФИЛЬ ===== -->
    <div class="screen" id="profile-screen">
        <div class="page-title" id="profileTitle">Профиль</div>
        <div class="profile-shift-down">
        <div class="profile-avatar" style="width:80px;height:80px;border-radius:50%;background:var(--glass-bg);border:2px solid var(--gold);margin:0 auto 12px;display:flex;align-items:center;justify-content:center;font-size:40px;">👤</div>
        <div style="text-align:center;margin-bottom:8px;">
            <div id="profileTgUsername" style="font-size:16px;font-weight:700;color:#fff;">@username</div>
            <div id="profileTgId" style="font-size:11px;color:var(--text-secondary);">ID: —</div>
        </div>
        <div style="text-align:center;margin-bottom:12px;">
            <input type="text" id="playerName" placeholder="Ваше имя" style="background:rgba(255,255,255,0.05);border:1px solid var(--glass-border);border-radius:10px;padding:8px 14px;color:#fff;width:100%;max-width:250px;font-size:16px;text-align:center;">
        </div>
        <div class="profile-stats" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
            <div class="stat" style="background:rgba(0,0,0,0.4);border-radius:10px;padding:10px;text-align:center;"><div class="label" style="font-size:11px;color:var(--text-secondary);">Уровень</div><div class="value" id="profileLevel" style="font-size:18px;font-weight:700;color:var(--gold);">1</div></div>
            <div class="stat" style="background:rgba(0,0,0,0.4);border-radius:10px;padding:10px;text-align:center;"><div class="label" style="font-size:11px;color:var(--text-secondary);">Опыт</div><div class="value" id="profileXp" style="font-size:18px;font-weight:700;color:var(--gold);">0</div></div>
            <div class="stat" style="background:rgba(0,0,0,0.4);border-radius:10px;padding:10px;text-align:center;"><div class="label" style="font-size:11px;color:var(--text-secondary);">Репутация</div><div class="value text-gold" id="profileReputation" style="font-size:18px;font-weight:700;color:var(--gold);">0</div></div>
            <div class="stat" style="background:rgba(0,0,0,0.4);border-radius:10px;padding:10px;text-align:center;"><div class="label" style="font-size:11px;color:var(--text-secondary);">Построено</div><div class="value" id="profileBuildings" style="font-size:18px;font-weight:700;color:var(--gold);">0</div></div>
            <div class="stat" style="background:rgba(0,0,0,0.4);border-radius:10px;padding:10px;text-align:center;"><div class="label" style="font-size:11px;color:var(--text-secondary);">Заработано</div><div class="value" id="profileEarned" style="font-size:18px;font-weight:700;color:var(--gold);">0</div></div>
            <div class="stat" style="background:rgba(0,0,0,0.4);border-radius:10px;padding:10px;text-align:center;"><div class="label" style="font-size:11px;color:var(--text-secondary);">Крипто-активы</div><div class="value" id="profileCryptoVal" style="font-size:18px;font-weight:700;color:var(--gold);">0</div></div>
        </div>
        <div style="text-align:center;margin-top:12px;font-size:12px;color:var(--text-secondary);">
            <span id="profileTime">В игре: 0 мин</span>
        </div>
        </div>
    </div>

    <!-- ===== ФУТЕР ОСНОВНОЙ ===== -->
    <div class="footer" id="footer">
        <button onclick="showScreen('bank-screen')" data-screen="bank-screen">
            <img src="https://rruslan007.github.io/novara-city-images/logo/bank_1.png" alt="Bank">
            <span class="label" id="footerBank">Bank</span>
        </button>
        <button onclick="showScreen('resources-screen')" data-screen="resources-screen">
            <img src="https://rruslan007.github.io/novara-city-images/logo/resources_icon.png" alt="Resources">
            <span class="label" id="footerResources">Resources</span>
        </button>
        <button onclick="showScreen('menu-screen')" data-screen="menu-screen" class="active">
            <img src="https://rruslan007.github.io/novara-city-images/logo/home_icon.png" alt="Home">
            <span class="label" id="footerHome">Home</span>
        </button>
        <button onclick="showScreen('quests-screen')" data-screen="quests-screen">
            <img src="https://rruslan007.github.io/novara-city-images/logo/tasks_icon.png" alt="Quests">
            <span class="label" id="footerQuests">Quests</span>
        </button>
        <button onclick="showScreen('profile-screen')" data-screen="profile-screen">
            <img src="https://rruslan007.github.io/novara-city-images/logo/profile_icon.png" alt="Profile">
            <span class="label" id="footerProfile">Profile</span>
        </button>
    </div>

    <!-- ===== ФУТЕР ГОРОДА ===== -->
    <div class="footer-city" id="footerCity">
        <button onclick="footerCityBack()" data-action="back" class="active">
            <img src="https://rruslan007.github.io/novara-city-images/logo/back.png" alt="back">
            <span class="label">Назад</span>
        </button>
        <button onclick="showToast('Совет: стройте здания для дохода')" data-action="sovet">
            <img src="https://rruslan007.github.io/novara-city-images/logo/sovet_icon.png" alt="sovet">
            <span class="label">Совет</span>
        </button>
        <button id="footerCityThird" onclick="showScreen('resources-screen')" data-action="resources">
            <img src="https://rruslan007.github.io/novara-city-images/logo/resources_icon.png" alt="resources">
            <span class="label">Ресурсы</span>
        </button>
    </div>

    <!-- ===== ОКНО ВЫБОРА РАЙОНА ===== -->
    <div class="district-select-modal" id="districtSelectModal">
        <div class="district-select-box">
            <button class="close-btn" onclick="closeDistrictSelect()">✕</button>
            <div class="select-title">Выберите район</div>
            <div class="district-select-grid" id="districtSelectGrid"></div>
        </div>
    </div>

    <!-- ===== МАГАЗИН (ОКНО) ===== -->
    <div id="shop-modal">
        <div class="shop-box">
            <div class="shop-header-bg">
                <button class="close-btn" onclick="closeShop()">✕</button>
                <h2 id="shopTitle">Магазин</h2>
            </div>
            <div class="shop-header">
                <div class="shop-balances">
                    <div class="bal-item"><img src="https://rruslan007.github.io/novara-city-images/effects/moneta.PNG" id="shopBalCoinsImg"> <span id="shopBalCoins">1000</span></div>
                    <div class="bal-item crystals-item">💎 <span id="shopBalCrystals">50</span></div>
                </div>
            </div>
            <div class="shop-scroll" id="shopScroll">
                <!-- NOVARA COIN -->
                <div class="shop-section" id="shopCoinSection">
                    <div class="section-title"><img src="https://rruslan007.github.io/novara-city-images/effects/moneta.PNG"> NOVARA COIN</div>
                    <div class="shop-items-grid" id="shopCoinItems"></div>
                </div>
                <!-- NOVARA DIAMONDS -->
                <div class="shop-section" id="shopDiamondSection">
                    <div class="section-title">💎 NOVARA DIAMONDS</div>
                    <div class="shop-items-grid" id="shopDiamondItems"></div>
                </div>
                <!-- Обменник -->
                <div class="shop-section shop-exchanger">
                    <div class="section-title">🔄 Обменник</div>
                    <div style="font-size:12px;font-style:italic;color:#ddd;">Обменяйте кристаллы на монеты по курсу</div>
                    <div style="font-weight:700;font-size:14px;color:var(--gold);">1 кристалл = 100 монет</div>
                    <div class="exchanger-row">
                        <button class="btn-gold" style="width:auto;padding:4px 12px;font-size:16px;" onclick="adjustExchange(-10)">−</button>
                        <span class="num-display" id="exchangerAmount" onclick="enableExchangeInput()">0</span>
                        <button class="btn-gold" style="width:auto;padding:4px 12px;font-size:16px;" onclick="adjustExchange(10)">+</button>
                    </div>
                    <div class="exchanger-result" id="exchangerResult">0 кристаллов = 0 монет</div>
                    <button class="btn-gold" onclick="openExchangeConfirm()" style="width:auto;padding:6px 20px;margin:0 auto;display:block;">Обменять</button>
                </div>
                <!-- Промокод -->
                <div class="promo-section">
                    <div class="promo-title">🎁 Промокод</div>
                    <div style="font-size:12px;color:#ddd;">Введите промокод</div>
                    <div class="promo-row">
                        <input type="text" id="promoInput" placeholder="Введите промокод">
                        <button onclick="applyPromo()">Применить</button>
                    </div>
                    <div class="promo-error" id="promoError">Промокод не найден или не действителен</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== НАСТРОЙКИ ===== -->
    <div class="modal-settings" id="settingsModal">
        <div class="settings-box">
            <div class="modal-header">
                <h2>Настройки</h2>
                <button class="close-btn" onclick="closeSettings()">✕</button>
            </div>
            <div class="modal-body">
                <div class="subtitle">Язык</div>
                <div class="center-text">Выбран: <span id="currentLangDisplay">Русский</span></div>
                <button class="btn-change-lang" onclick="openLangModal()">Сменить язык</button>
            </div>
        </div>
    </div>

    <!-- ===== ОКНО СТРОИТЕЛЬСТВА ===== -->
    <div class="modal-overlay" id="buildModal">
        <div class="modal-box-build" style="position:relative;background:var(--bg-primary);border-radius:24px 24px 0 0;padding:20px 16px 30px;max-width:420px;width:100%;max-height:85vh;border-top:1px solid var(--glass-border);box-shadow:0 -10px 40px rgba(0,0,0,0.8);animation:slideUp 0.3s ease;display:flex;flex-direction:column;">
            <button class="close-btn" onclick="closeBuildModal()" style="position:absolute;top:12px;right:12px;background:rgba(255,255,255,0.05);border:1px solid var(--glass-border);color:var(--text-secondary);font-size:20px;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;">✕</button>
            <h2 id="buildModalTitle" style="margin-bottom:16px;color:#fff;font-size:18px;font-weight:700;text-align:center;">Строительство</h2>
            <div class="build-grid" id="buildModalList" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;overflow-y:auto;padding-right:4px;flex:1;"></div>
        </div>
    </div>

    <!-- ===== ОКНО ИНФОРМАЦИИ О ЗДАНИИ ===== -->
    <div class="modal-overlay" id="buildingInfoModal" style="align-items:center;">
        <div class="modal-box-info" style="position:relative;background:var(--bg-secondary);border-radius:24px;padding:24px;max-width:380px;width:100%;max-height:85vh;overflow-y:auto;border:1px solid var(--glass-border);box-shadow:var(--glass-shadow);text-align:center;">
            <button class="close-btn" onclick="closeBuildingInfo()" style="position:absolute;top:12px;right:12px;background:none;border:none;color:var(--red);font-size:24px;cursor:pointer;">✕</button>
            <img id="infoBuildingImg" src="" alt="building" style="width:80px;height:80px;border-radius:12px;object-fit:cover;margin-bottom:12px;">
            <h3 id="infoBuildingName" style="margin-bottom:8px;"></h3>
            <div class="info-row" style="font-size:13px;margin:6px 0;color:var(--text-secondary);">Состояние: <span id="infoState" style="color:#fff;"></span></div>
            <div class="info-row" style="font-size:13px;margin:6px 0;color:var(--text-secondary);display:flex;align-items:center;justify-content:center;gap:4px;">Электричество: <img src="https://rruslan007.github.io/novara-city-images/resources/energy_icon.png" style="width:14px;height:14px;" onerror="this.style.display='none'"> <span id="infoEnergy" style="color:#fff;">0</span>/час</div>
            <div class="info-row" style="font-size:13px;margin:6px 0;color:var(--text-secondary);">Репутация: <span id="infoReputation" style="color:#fff;">0</span></div>
            <div class="built-date" style="font-size:11px;color:var(--text-secondary);font-weight:300;margin-top:8px;"><span style="font-weight:300;">Построено:</span> <span id="infoBuiltDate"></span></div>
            <button class="btn-gold demolish" onclick="openDemolishConfirm()" style="width:auto;padding:8px 20px;margin-top:12px;">🏗️ Снести</button>
        </div>
    </div>

    <!-- ===== ОКНО ПОДТВЕРЖДЕНИЯ СНОСА ===== -->
    <div class="modal-confirm" id="demolishConfirm" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.7);z-index:600;justify-content:center;align-items:center;padding:20px;">
        <div class="confirm-box" style="background:#1a3a6a;border-radius:16px;max-width:340px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.8);">
            <div class="confirm-header" style="background:#1e447a;padding:14px 20px;font-size:16px;font-weight:600;text-align:center;">⚠️ Снос здания</div>
            <div class="confirm-body" style="padding:16px 20px;text-align:center;color:var(--text-secondary);font-size:13px;">
                <p>Вы точно хотите снести данное здание?</p>
                <p class="cost" id="demolishCostText" style="font-size:11px;margin-top:4px;color:var(--text-secondary);">Стоимость сноса: 0 монет</p>
            </div>
            <div class="confirm-actions" style="display:flex;gap:0;border-top:1px solid rgba(255,255,255,0.1);">
                <button class="btn-cancel" onclick="closeDemolishConfirm()" style="flex:1;padding:12px;border:none;font-size:14px;font-weight:600;cursor:pointer;background:#1e447a;color:#fff;">Отмена</button>
                <button class="btn-confirm" id="confirmDemolishBtn" onclick="confirmDemolish()" style="flex:1;padding:12px;border:none;font-size:14px;font-weight:600;cursor:pointer;background:var(--gold-gradient);color:#1a1a2e;">Подтвердить</button>
            </div>
            <div class="error-text" id="demolishError" style="display:none;color:var(--red);font-size:10px;text-align:center;padding:4px;">Вам не хватает 0 монет</div>
        </div>
    </div>

    <!-- ===== КРИПТО-БИРЖА ===== -->
    <div class="modal-overlay" id="cryptoModal" style="align-items:center;">
        <div class="modal-box" style="position:relative;background:var(--bg-secondary);border-radius:24px;padding:24px;max-width:420px;width:100%;max-height:85vh;overflow-y:auto;border:1px solid var(--glass-border);box-shadow:var(--glass-shadow);">
            <button class="close-btn" onclick="closeCryptoModal()" style="position:absolute;top:12px;right:12px;background:none;border:none;color:var(--red);font-size:24px;cursor:pointer;">✕</button>
            <h2 id="cryptoModalTitle" style="text-align:center;">Биржа</h2>
            <div style="display:flex;gap:4px;margin-bottom:8px;flex-wrap:wrap;">
                <button class="btn-gold" style="flex:1;padding:6px;font-size:12px;" onclick="switchCryptoTab('main')" id="cryptoTabMain">Основные</button>
                <button class="btn-gold" style="flex:1;padding:6px;font-size:12px;background:rgba(255,255,255,0.05);color:#fff;" onclick="switchCryptoTab('exclusive')" id="cryptoTabExclusive">Эксклюзив</button>
                <button class="btn-gold" style="flex:1;padding:6px;font-size:12px;background:rgba(255,255,255,0.05);color:#fff;" onclick="switchCryptoTab('sell')" id="cryptoTabSell">Продажа</button>
            </div>
            <input type="text" id="cryptoSearch" placeholder="🔍 Поиск..." style="width:100%;padding:8px 12px;border-radius:10px;border:1px solid var(--glass-border);background:rgba(255,255,255,0.05);color:#fff;margin-bottom:8px;">
            <div id="cryptoList" style="max-height:300px;overflow-y:auto;"></div>
        </div>
    </div>

    <!-- ===== КРЕДИТ ===== -->
    <div class="modal-overlay" id="creditModal" style="align-items:center;">
        <div class="modal-box" style="position:relative;background:var(--bg-secondary);border-radius:24px;padding:24px;max-width:420px;width:100%;max-height:85vh;overflow-y:auto;border:1px solid var(--glass-border);box-shadow:var(--glass-shadow);">
            <button class="close-btn" onclick="closeCreditModal()" style="position:absolute;top:12px;right:12px;background:none;border:none;color:var(--red);font-size:24px;cursor:pointer;">✕</button>
            <h2 id="creditModalTitle" style="text-align:center;">💰 Взять кредит</h2>
            <div id="creditForm">
                <div style="margin-bottom:8px;">
                    <div class="flex-between" style="display:flex;justify-content:space-between;align-items:center;"><span>Сумма: <span id="creditAmountDisplay">0</span></span></div>
                    <input type="range" id="creditAmountSlider" min="0" max="1000" step="50" value="0" style="width:100%;">
                </div>
                <div style="margin-bottom:8px;">
                    <div class="flex-between" style="display:flex;justify-content:space-between;align-items:center;"><span id="creditTermLabel">Срок: <span id="creditTermDisplay">1</span> дн.</span></div>
                    <input type="range" id="creditTermSlider" min="1" max="2" step="1" value="1" style="width:100%;">
                </div>
                <div style="margin-bottom:8px;background:rgba(255,255,255,0.03);padding:8px;border-radius:8px;font-size:13px;">
                    <div class="flex-between" style="display:flex;justify-content:space-between;align-items:center;"><span>Процентная ставка:</span><span class="text-red" id="creditRateDisplay">0%</span></div>
                    <div class="flex-between" style="display:flex;justify-content:space-between;align-items:center;"><span>Итоговая сумма к выплате:</span><span id="creditTotalPayDisplay">0</span></div>
                    <div class="flex-between" style="display:flex;justify-content:space-between;align-items:center;"><span>Ежемесячный платеж:</span><span id="creditMonthlyPayDisplay">0</span></div>
                </div>
                <button class="btn-gold" onclick="takeCredit()">Взять кредит</button>
            </div>
            <div id="creditLock" style="display:none;text-align:center;padding:20px;">
                <div style="font-size:48px;">🔒</div>
                <div style="color:var(--text-secondary);">У вас уже есть активный кредит. Погасите его, чтобы взять новый.</div>
            </div>
        </div>
    </div>

    <!-- ===== ВЫПЛАТА КРЕДИТА ===== -->
    <div class="modal-overlay" id="repayModal" style="align-items:center;">
        <div class="modal-box" style="position:relative;background:var(--bg-secondary);border-radius:24px;padding:24px;max-width:420px;width:100%;max-height:85vh;overflow-y:auto;border:1px solid var(--glass-border);box-shadow:var(--glass-shadow);">
            <button class="close-btn" onclick="closeRepayModal()" style="position:absolute;top:12px;right:12px;background:none;border:none;color:var(--red);font-size:24px;cursor:pointer;">✕</button>
            <h2 id="repayTitle" style="text-align:center;">💳 Выплата</h2>
            <div style="text-align:center;color:var(--text-secondary);font-size:14px;">Введите сумму для погашения</div>
            <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin:12px 0;overflow-x:hidden;touch-action:pan-y;">
                <button class="btn-green" style="width:36px;height:36px;border-radius:50%;padding:0;flex-shrink:0;" onclick="adjustRepay(-10)">−</button>
                <input type="number" id="repayAmount" value="0" style="width:90px;flex:none;padding:8px;border-radius:10px;border:2px solid var(--gold);background:rgba(255,255,255,0.05);color:#fff;font-size:18px;font-weight:700;text-align:center;touch-action:pan-y;overscroll-behavior-x:none;">
                <button class="btn-green" style="width:36px;height:36px;border-radius:50%;padding:0;flex-shrink:0;" onclick="adjustRepay(10)">+</button>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--text-secondary);">
                <span>Баланс: <span id="repayBalance">0</span></span>
                <span>Остаток: <span id="repayRemaining">0</span></span>
            </div>
            <button class="btn-gold mt-8" id="repayBtn" onclick="confirmRepay()" disabled style="margin-top:8px;">Выплатить</button>
        </div>
    </div>

    <!-- ===== ОКНО ПОДТВЕРЖДЕНИЯ ОБМЕНА ===== -->
    <div class="confirm-overlay" id="exchangeConfirm">
        <div class="confirm-box">
            <div class="confirm-header">
                <span>Подтверждение</span>
                <button class="close-btn" onclick="closeExchangeConfirm()">✕</button>
            </div>
            <div class="confirm-body" id="exchangeConfirmText">Вы точно хотите обменять 0 кристаллов на 0 монет?</div>
            <div class="confirm-actions">
                <button class="btn-cancel" onclick="closeExchangeConfirm()">Отмена</button>
                <button class="btn-confirm" onclick="confirmExchange()">Подтвердить</button>
            </div>
        </div>
    </div>

    <!-- ===== РЫНОК (ОКНО) ===== -->
    <div id="marketModal">
        <div class="market-box">
            <div class="market-header-bg">
                <button class="close-btn" onclick="closeMarket()">✕</button>
                <h2 id="marketTitle">Рынок</h2>
            </div>
            <div class="market-timer" id="marketTimerText">Обновится через: 00:00:00</div>
            <div class="market-scroll">
                <div class="market-grid" id="marketGrid"></div>
            </div>
        </div>
    </div>

    <!-- ===== ОКНО ПОДТВЕРЖДЕНИЯ ПОКУПКИ НА РЫНКЕ ===== -->
    <div class="confirm-overlay" id="marketConfirm">
        <div class="confirm-box">
            <div class="confirm-header">
                <span id="marketConfirmHeader">Подтверждение</span>
                <button class="close-btn" onclick="closeMarketConfirm()">✕</button>
            </div>
            <div class="confirm-body" id="marketConfirmText">Купить?</div>
            <div class="confirm-actions">
                <button class="btn-cancel" id="marketConfirmCancelBtn" onclick="closeMarketConfirm()">Отмена</button>
                <button class="btn-confirm" id="marketConfirmOkBtn" onclick="confirmMarketBuy()">Подтвердить</button>
            </div>
        </div>
    </div>

    <!-- ===== ОФЛАЙН ЗАРАБОТОК ===== -->
    <div class="modal-overlay" id="offlineEarningsModal" style="align-items:center;">
        <div style="position:relative;background:linear-gradient(160deg,#00c853,#00913c);border:4px solid var(--gold);border-radius:20px;max-width:400px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.7);">
            <div style="background:rgba(0,0,0,0.25);padding:16px 20px;text-align:center;">
                <h2 id="offlineEarningsTitle" style="margin:0;color:#fff;font-size:20px;font-weight:800;">Офлайн заработок</h2>
            </div>
            <div style="padding:20px;text-align:center;">
                <p id="offlineEarningsText" style="color:#fff;font-size:15px;margin-bottom:16px;">Пока вас не было в игре, вы заработали...</p>
                <button class="btn-gold" id="offlineEarningsClaimBtn" onclick="claimOfflineEarnings()" style="width:auto;padding:10px 28px;">Получить</button>
            </div>
        </div>
    </div>


    <!-- ===== ЗАТЕМНЕНИЕ ===== -->
    <div class="fade-overlay" id="fadeOverlay"></div>

    <!-- ===== TOAST ===== -->
    <div id="toast" style="position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.85);backdrop-filter:blur(8px);padding:10px 20px;border-radius:12px;font-size:14px;z-index:9999;opacity:0;transition:opacity 0.3s;pointer-events:none;border:1px solid var(--glass-border);color:#fff;white-space:nowrap;"></div>

    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script>
        // ============================================================
        // TELEGRAM WEBAPP
        // ============================================================
        let tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
        if (tg) {
            tg.ready();
            // При необходимости расширить окно на весь экран
            tg.expand();
        }
        // Сайт и API отдаются одним и тем же Flask-сервером, поэтому используем относительные пути —
        // это работает автоматически на любом домене Render без правки кода.
        const API_BASE_URL = 'https://novara-city-server-py.onrender.com';
        const PAYMENT_SERVER_URL = API_BASE_URL + '/create_invoice';

        // ============================================================
        // TELEGRAM ПОЛЬЗОВАТЕЛЬ И СИНХРОНИЗАЦИЯ С СЕРВЕРОМ
        // ============================================================
        const tgUser = tg && tg.initDataUnsafe && tg.initDataUnsafe.user ? tg.initDataUnsafe.user : null;
        const TELEGRAM_USER_ID = tgUser ? tgUser.id : null;
        const TELEGRAM_USERNAME = tgUser ? (tgUser.username || tgUser.first_name || String(tgUser.id)) : null;

        function updateProfileTelegramUI() {
            const idEl = document.getElementById('profileTgId');
            const nameEl = document.getElementById('profileTgUsername');
            if (idEl) idEl.textContent = 'ID: ' + (TELEGRAM_USER_ID || '—');
            if (nameEl) nameEl.textContent = TELEGRAM_USERNAME ? '@' + TELEGRAM_USERNAME.replace(/^@/, '') : (lang === 'ru' ? 'Гость (не через Telegram)' : 'Guest (not via Telegram)');
        }

        // Подтягиваем сохранённый на сервере прогресс при первом запуске (например, на новом устройстве)
        function fetchProfileFromServer() {
            if (!TELEGRAM_USER_ID) return;
            fetch(`${API_BASE_URL}/api/profile/${TELEGRAM_USER_ID}`)
                .then(r => r.ok ? r.json() : null)
                .then(data => {
                    if (data && data.user) {
                        // Локальное сохранение в браузере остаётся источником истины для уже открытой сессии,
                        // серверные данные используются только если локального сохранения ещё нет.
                        if (!localStorage.getItem('novaraCitySave')) {
                            Object.assign(game, {
                                balance: data.user.balance, crystals: data.user.crystals,
                                level: data.user.level, xp: data.user.xp, reputation: data.user.reputation,
                                credit: data.user.credit, crypto: data.user.crypto || game.crypto
                            });
                            saveGame();
                            updateUI();
                        }
                    }
                })
                .catch(err => console.error('Profile fetch error:', err));
        }

        // Отправляем текущее состояние профиля на сервер (Supabase). Вызывается из saveGame().
        let syncTimeout;
        function syncProfileToServer() {
            if (!TELEGRAM_USER_ID) return;
            clearTimeout(syncTimeout);
            // Небольшая задержка, чтобы не слать запрос на каждое мелкое изменение
            syncTimeout = setTimeout(() => {
                fetch(`${API_BASE_URL}/api/profile/sync`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        user_id: TELEGRAM_USER_ID,
                        username: TELEGRAM_USERNAME,
                        level: game.level,
                        xp: game.xp,
                        reputation: game.reputation,
                        balance: Math.round(game.balance),
                        crystals: Math.round(game.crystals),
                        buildings_count: game.buildings ? game.buildings.filter(b => b.status === 'built').length : 0,
                        credit: game.credit || null,
                        crypto: game.crypto || {},
                        income_per_min: typeof getTotalIncome === 'function' ? getTotalIncome() : 0,
                        expenses_per_min: typeof getTotalExpensePerMin === 'function' ? getTotalExpensePerMin() : 0
                    })
                }).catch(err => console.error('Profile sync error:', err));
            }, 800);
        }

        function initiatePurchase(itemType, amount, price) {
            // Получаем user_id из данных Telegram WebApp
            const userId = tg && tg.initDataUnsafe && tg.initDataUnsafe.user ? tg.initDataUnsafe.user.id : null;
            if (!userId) {
                showToast(lang === 'ru' ? '❌ Не удалось определить пользователя. Запустите приложение через Telegram.' : '❌ Could not identify user. Please open this app via Telegram.');
                return;
            }
            showToast(lang === 'ru' ? '⏳ Создаём счёт...' : '⏳ Creating invoice...');
            // Отправляем запрос на наш сервер
            fetch(PAYMENT_SERVER_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    user_id: userId,
                    item_type: itemType,
                    amount: amount,
                    price: price
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.invoice_link) {
                    // Открываем ссылку на оплату через Telegram WebApp
                    tg.openInvoice(data.invoice_link, function(status) {
                        if (status === 'paid') {
                            showToast(lang === 'ru' ? '✅ Оплата прошла успешно!' : '✅ Payment successful!');
                        } else if (status === 'cancelled') {
                            showToast(lang === 'ru' ? 'Оплата отменена' : 'Payment cancelled');
                        } else if (status === 'failed') {
                            showToast(lang === 'ru' ? '❌ Оплата не прошла' : '❌ Payment failed');
                        }
                    });
                } else {
                    showToast((lang === 'ru' ? '❌ Ошибка создания счёта: ' : '❌ Invoice error: ') + (data.error || ''));
                }
            })
            .catch(err => {
                showToast(lang === 'ru' ? '❌ Ошибка соединения с сервером.' : '❌ Server connection error.');
                console.error(err);
            });
        }

        // ============================================================
        // ЛОКАЛИЗАЦИЯ (упрощенная)
        // ============================================================
        const LANG = {
            en: {
                appName: "Novara City", bank: "Bank", resources: "Resources", quests: "Quests", profile: "Profile",
                back: "Back", balance: "Balance", coins: "Coins", crystals: "Crystals", noCredit: "No active credits",
                noCrypto: "You have no cryptocurrencies", income: "Income", expense: "Expenses",
                bankMy: "My Bank", credit: "Credit", crypto: "Cryptocurrency", stats: "Income & Expenses",
                settings: "Settings", city: "City", menu: "Menu", shop: "Shop",
                language: "Language", selected: "Selected", changeLang: "Change language",
                district1: "Suburb", district2: "Countryside", district3: "Residential", district4: "Midtown",
                district5: "Commercial", district6: "Transport Hub", district7: "Industrial Zone",
                district8: "Tech Park", coming: "Coming soon", openDistrictBtn: "Open",
                market: "Market", offlineEarnings: "Offline Earnings", receive: "Receive",
                marketRefreshIn: "Refreshes in:", sold: "SOLD", refreshFor: "Refresh for", buy: "Buy",
                needResources: "Resources needed"
            },
            ru: {
                appName: "Novara City", bank: "Банк", resources: "Ресурсы", quests: "Квесты", profile: "Профиль",
                back: "Назад", balance: "Баланс", coins: "Монеты", crystals: "Кристаллы", noCredit: "Нет активных кредитов",
                noCrypto: "У вас нет криптовалют", income: "Доходы", expense: "Расходы",
                bankMy: "Мой банк", credit: "Кредит", crypto: "Криптовалюта", stats: "Доходы и расходы",
                settings: "Настройки", city: "Город", menu: "Меню", shop: "Магазин",
                language: "Язык", selected: "Выбран", changeLang: "Сменить язык",
                district1: "Обычный посёлок", district2: "Пригород", district3: "Жилой район", district4: "Средний посёлок",
                district5: "Торговый район", district6: "Транспортный хаб", district7: "Промышленная зона",
                district8: "Технопарк", coming: "Скоро", openDistrictBtn: "Открыть",
                market: "Рынок", offlineEarnings: "Офлайн заработок", receive: "Получить",
                marketRefreshIn: "Обновится через:", sold: "ПРОДАНО", refreshFor: "Обновить за", buy: "Купить",
                needResources: "Нужно ресурсов"
            }
        };

        let lang = 'ru';
        let currentLang = {};

        function setLang(l) {
            lang = l;
            currentLang = LANG[lang];
            localStorage.setItem('lang', lang);
            document.getElementById('langModal').classList.remove('active');
            updateUI();
            showToast('🌐 Язык изменён');
        }

        function t(key) { return currentLang[key] || key; }

        function updateUI() {
            document.getElementById('footerBank').textContent = t('bank');
            document.getElementById('footerResources').textContent = t('resources');
            document.getElementById('footerHome').textContent = t('menu');
            document.getElementById('footerQuests').textContent = t('quests');
            document.getElementById('footerProfile').textContent = t('profile');
            document.getElementById('bankMyBank').textContent = t('bankMy');
            document.getElementById('bankMyBankTitle').textContent = t('bankMy');
            document.getElementById('bankReplenishBtn').textContent = lang === 'ru' ? 'Пополнить' : 'Top up';
            document.getElementById('bankCredit').textContent = t('credit');
            document.getElementById('bankCreditTitle').textContent = t('credit');
            document.getElementById('bankTakeCredit').textContent = lang === 'ru' ? 'Взять кредит' : 'Take credit';
            document.getElementById('bankCrypto').textContent = t('crypto');
            document.getElementById('bankStats').textContent = t('stats');
            document.getElementById('bankStatsTitle').textContent = t('stats');
            document.getElementById('bankIncomeLabel').textContent = '📈 ' + t('income') + ':';
            document.getElementById('bankExpenseLabel').textContent = '📉 ' + t('expense') + ':';
            document.getElementById('bankIncomeSuffix').textContent = lang === 'ru' ? '/мин' : '/min';
            document.getElementById('bankExpenseSuffix').textContent = lang === 'ru' ? '/мин' : '/min';
            document.getElementById('bankTitle').textContent = t('bank');
            document.getElementById('resourcesTitle').textContent = t('resources');
            document.getElementById('questsTitle').textContent = t('quests');
            document.getElementById('profileTitle').textContent = t('profile');
            document.getElementById('menuSettingsLabel').textContent = t('settings');
            document.getElementById('currentLangDisplay').textContent = lang === 'ru' ? 'Русский' : 'English';
            const resBankCoins = document.getElementById('resBankCoins');
            if (resBankCoins) resBankCoins.textContent = Math.round(game.balance);
            const resBankCrystals = document.getElementById('resBankCrystals');
            if (resBankCrystals) resBankCrystals.textContent = game.crystals;
            const marketBtn = document.getElementById('resMarketBtn');
            if (marketBtn) marketBtn.textContent = t('market');
            renderCityGrid();
            renderQuests();
            updateProfileUI();
            updateBankUI();
        }

        // ============================================================
        // ДАННЫЕ
        // ============================================================
        const BASE_URL = 'https://rruslan007.github.io/novara-city-images/';
        const MONETA_ICON = BASE_URL + 'effects/moneta.PNG';

        // Район "Парк" удалён; последний слот (уровень 9) теперь "Скоро"
        const DISTRICTS_DATA = [
            { id: 'suburb', icon: BASE_URL + 'districts/malii_poselok.png', key: 'district1', level: 1 },
            { id: 'countryside', icon: BASE_URL + 'districts/elita_poselok.png', key: 'district2', level: 2 },
            { id: 'residential', icon: BASE_URL + 'districts/jiloi_raion.png', key: 'district3', level: 3 },
            { id: 'midtown', icon: BASE_URL + 'districts/centre.png', key: 'district4', level: 4 },
            { id: 'commercial', icon: BASE_URL + 'districts/portovii_raion.png', key: 'district5', level: 5 },
            { id: 'transport', icon: BASE_URL + 'districts/portovii_raion.png', key: 'district6', level: 6 },
            { id: 'industrial', icon: BASE_URL + 'districts/portovii_raion.png', key: 'district7', level: 7 },
            { id: 'techpark', icon: BASE_URL + 'districts/oficini_raion.png', key: 'district8', level: 8 }
        ];

        // Список районов для выбора в окне (8 штук, названия берутся из LANG по ключу)
        const DISTRICT_SELECT = [
            { id: 'suburb', key: 'district1', icon: BASE_URL + 'districts/malii_poselok.png' },
            { id: 'countryside', key: 'district2', icon: BASE_URL + 'districts/elita_poselok.png' },
            { id: 'residential', key: 'district3', icon: BASE_URL + 'districts/jiloi_raion.png' },
            { id: 'midtown', key: 'district4', icon: BASE_URL + 'districts/centre.png' },
            { id: 'commercial', key: 'district5', icon: BASE_URL + 'districts/portovii_raion.png' },
            { id: 'transport', key: 'district6', icon: BASE_URL + 'districts/portovii_raion.png' },
            { id: 'industrial', key: 'district7', icon: BASE_URL + 'districts/portovii_raion.png' },
            { id: 'techpark', key: 'district8', icon: BASE_URL + 'districts/oficini_raion.png' }
        ];
        // Лимиты построек по посёлкам (id района -> id здания -> лимит). Не указано = используется maxCount здания.
        const DISTRICT_BUILD_LIMITS = {
            suburb: { house: 50, modern_house: 30, store: 20, coffee: 10, workshop: 15 },
            countryside: { house: 100, modern_house: 60, store: 30, coffee: 20, workshop: 25 },
            residential: { house: 40, apartment: 40, modern_house: 60, school: 6, kindergarten: 8, pharmacy: 15 },
            midtown: { office: 25, supermarket: 12, hospital: 4, library: 10, theater: 6 },
            commercial: { store: 50, mall: 6, trc: 6, restaurant: 20, supermarket: 15 },
            transport: { workshop: 30, power: 10, factory: 6, office: 10 },
            industrial: { factory: 15, power: 15, workshop: 40 },
            techpark: { university: 4, business: 6, office: 30, library: 12 }
        };
        function getBuildingLimit(districtId, buildingId, defaultMax) {
            const dLimits = DISTRICT_BUILD_LIMITS[districtId];
            if (dLimits && dLimits[buildingId] !== undefined) return dLimits[buildingId];
            return defaultMax;
        }

        const RESOURCES = [
            { id: 'oil', name: 'Нефть', unit: 'барр.', icon: BASE_URL + 'resources/oil_icon.png', amount: 10 },
            { id: 'gas', name: 'Газ', unit: 'м³', icon: BASE_URL + 'resources/gas.png', amount: 10 },
